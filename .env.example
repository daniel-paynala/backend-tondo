APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Paynala Payment Gateway — Airtel Money Gabon
# Staging : PAYNALA_BASE_URL=https://testapi.paynala.com/functions/v1
# Prod    : PAYNALA_BASE_URL=https://api.paynala.com/functions/v1
PAYNALA_CLIENT_ID=
PAYNALA_CLIENT_SECRET=
PAYNALA_BASE_URL=https://testapi.paynala.com/functions/v1

# OneSignal — Push notifications (Keys & IDs dans le dashboard OneSignal)
ONESIGNAL_APP_ID=cf4267e6-40ab-4c11-8583-67b7ee990032
ONESIGNAL_REST_API_KEY=

# ── Canal WhatsApp ──────────────────────────────────────────────────────────
# Fournisseur actif : "twilio" ou "meta". Bascule globale (réception + envoi).
WHATSAPP_DRIVER=twilio

# Twilio WhatsApp (compte pouvant différer du compte SMS/OTP)
TWILIO_WA_ACCOUNT_SID=
TWILIO_WA_AUTH_TOKEN=
TWILIO_WA_NUMBER=whatsapp:+14155238886
TONJI_BOT_WA_NUMERO=+14155238886

# Meta WhatsApp Cloud API (requis si WHATSAPP_DRIVER=meta)
#   META_WHATSAPP_TOKEN            : access token permanent (System User)
#   META_WHATSAPP_PHONE_NUMBER_ID  : Phone Number ID du numéro expéditeur
#   META_WHATSAPP_APP_SECRET       : App Secret (validation X-Hub-Signature-256)
#   META_WHATSAPP_VERIFY_TOKEN     : token de vérification du webhook (GET Meta)
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
