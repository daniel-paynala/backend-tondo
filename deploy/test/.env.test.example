# =============================================================================
#  .env de l'environnement de TEST — api-test.tonji.ga (instance 13.39.79.94)
#
#  Dérivé du .env local, avec les écarts NON NÉGOCIABLES marqués ⚠️.
#  À copier en .env sur l'instance, puis compléter les valeurs.
# =============================================================================

APP_NAME=Tonji
APP_ENV=staging                      # ⚠️ pilote les gardes des crons d'argent
APP_DEBUG=false                      # ⚠️ jamais true sur une machine joignable
APP_URL=https://api-test.tonji.ga
APP_KEY=                             # php artisan key:generate

# ── Base de TEST (projet Supabase itgjlhaalodlgwsyrjnz) ─────────────────────
DB_CONNECTION=pgsql
DB_HOST=aws-1-eu-west-2.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
SUPABASE_URL=https://itgjlhaalodlgwsyrjnz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Paynala : BAC À SABLE ───────────────────────────────────────────────────
# ⚠️ LE PIÈGE À NE PAS REPRODUIRE. Le .env local pointe sur api.paynala.com,
# c'est-à-dire la PRODUCTION. Déployé tel quel ici, un test de décaissement
# TPE déplacerait de l'argent réel.
PAYNALA_BASE_URL=https://testapi.paynala.com/functions/v1
PAYNALA_CLIENT_ID=
PAYNALA_CLIENT_SECRET=
PAYNALA_OPERATOR_KEY=

# ── Canaux sortants ─────────────────────────────────────────────────────────
# SMS et WhatsApp partent vers de VRAIS téléphones, même depuis le test.
# Renseigner TWILIO_OVERRIDE_RECIPIENT redirige tous les OTP vers un seul
# numéro : indispensable tant que la base de test contient des numéros réels.
OTP_DRIVER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_OVERRIDE_RECIPIENT=

WHATSAPP_DRIVER=twilio
TWILIO_WA_ACCOUNT_SID=
TWILIO_WA_AUTH_TOKEN=
TWILIO_WA_NUMBER=

# ── Push : laisser VIDE sur test ────────────────────────────────────────────
# Sans compte de service FCM, estConfigure() renvoie false et les push sont
# ignorés proprement. C'est le comportement voulu : pas de notification
# envoyée à de vrais appareils depuis l'environnement de test.
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=

LOG_CHANNEL=stack
LOG_LEVEL=info
