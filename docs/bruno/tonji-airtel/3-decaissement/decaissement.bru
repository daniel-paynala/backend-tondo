meta {
  name: Décaissement — B2C / B2B selon le KYC
  type: http
  seq: 1
}

post {
  url: {{airtel_base_url}}/disburse
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  x-operator-key: {{airtel_operator_key}}
}

body:json {
  {
    "msisdn": "{{airtel_msisdn}}",
    "amount": {{montant_decaissement}},
    "reference": "{{reference_decaissement}}",
    "idempotency_key": "{{idempotency_key}}",
    "type": "{{type_decaissement}}"
  }
}

script:pre-request {
  // Lecture d'une valeur : variable d'exécution, sinon environnement, sinon défaut.
  // Bruno garde les `vars` de collection en lecture seule, d'où ce passage par les
  // variables d'exécution pour tout ce qui change pendant un run.
  const lire = (cle, defaut) => {
    const execution = bru.getVar(cle);
    if (execution !== undefined && execution !== null && execution !== "") return execution;
    const env = bru.getEnvVar(cle);
    if (env !== undefined && env !== null && env !== "") return env;
    return defaut;
  };

  // ─── Garde-fou ───────────────────────────────────────────────────────────────
  // Un décaissement sort de l'argent réel : il n'existe aucun bac à sable
  // Paynala. La requête ne part que si l'environnement porte explicitement
  // autoriser_decaissement = oui.
  const autorise = String(lire("autoriser_decaissement", "non")).toLowerCase();
  const montant = Number(lire("montant_decaissement", 0));
  const plafond = Number(lire("plafond_montant_test", 500));

  if (autorise !== "oui") {
    throw new Error("autoriser_decaissement != oui — requête bloquée (argent réel, " +
      "aucun bac à sable). Passer la variable à « oui » dans l'environnement, puis la remettre.");
  }
  if (!(montant > 0)) {
    throw new Error("montant_decaissement doit être un entier > 0.");
  }
  if (montant > plafond) {
    throw new Error("Décaissement de " + montant + " FCFA refusé : plafond de test = " +
      plafond + " FCFA.");
  }
  if (!lire("airtel_operator_key", "")) {
    throw new Error("airtel_operator_key manquante : l'endpoint disburse refuse sans x-operator-key.");
  }

  // Suffixe aléatoire de 9 caractères alphanumériques majuscules, comme
  // Str::random(9) côté backend. Pas de tiret : l'API les refuse.
  const ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789";
  let suffixe = "";
  for (let i = 0; i < 9; i++) {
    suffixe += ALPHABET.charAt(Math.floor(Math.random() * ALPHABET.length));
  }

  // Clé d'idempotence = le trans_id du payout, comme en base. Elle était dérivée
  // d'un COUNT(*) + 1 : deux décaissements simultanés tombaient sur la même clé
  // et l'un écrasait l'autre (incident du 2026-08-31).
  const transId = lire("prefixe_payout", "TONJIPAYOUT") + suffixe;
  bru.setVar("idempotency_key", transId);
  bru.setVar("trans_id_payout", transId);
  // Référence lisible transmise à l'opérateur, format du backend.
  bru.setVar("reference_decaissement", "TONJIDISBURSEMENT" + Date.now());

  console.log("[airtel] décaissement " + montant + " FCFA vers " + lire("airtel_msisdn", "?") +
    " en " + lire("type_decaissement", "B2C") + " — clé " + transId);
}

script:post-response {
  // Lecture d'une valeur : variable d'exécution, sinon environnement, sinon défaut.
  // Bruno garde les `vars` de collection en lecture seule, d'où ce passage par les
  // variables d'exécution pour tout ce qui change pendant un run.
  const lire = (cle, defaut) => {
    const execution = bru.getVar(cle);
    if (execution !== undefined && execution !== null && execution !== "") return execution;
    const env = bru.getEnvVar(cle);
    if (env !== undefined && env !== null && env !== "") return env;
    return defaut;
  };

  const corps = res.getBody() || {};
  const donnees = corps.data || corps;

  if (donnees.airtel_money_id) {
    bru.setVar("airtel_money_id", donnees.airtel_money_id);
    // Mémorisé pour le rejeu d'idempotence.
    bru.setVar("idempotency_key_rejeu", bru.getVar("idempotency_key"));
    console.log("[airtel] décaissement accepté — airtel_money_id " + donnees.airtel_money_id);
  }

  // « Transaction Ambiguous » = routage B2B vers un compte particulier (ou
  // l'inverse). C'est le grade KYC qui tranche, pas une préférence.
  if (corps.success !== true) {
    const message = (corps.error && corps.error.message) || corps.message || "";
    if (String(message).toLowerCase().indexOf("ambiguous") !== -1) {
      console.error("[airtel] routage B2B/B2C incorrect pour ce numéro — relancer le KYC et " +
        "vérifier type_decaissement (actuel : " + lire("type_decaissement", "?") + ")");
    }
  }
}

tests {
  // Lecture d'une valeur : variable d'exécution, sinon environnement, sinon défaut.
  // Bruno garde les `vars` de collection en lecture seule, d'où ce passage par les
  // variables d'exécution pour tout ce qui change pendant un run.
  const lire = (cle, defaut) => {
    const execution = bru.getVar(cle);
    if (execution !== undefined && execution !== null && execution !== "") return execution;
    const env = bru.getEnvVar(cle);
    if (env !== undefined && env !== null && env !== "") return env;
    return defaut;
  };

  // Mode brut (défaut) : la réponse passe telle quelle, aucune vérification n'est
  // jouée. Mettre mode_brut = non pour les rallumer. L'enchaînement des variables,
  // lui, se fait dans script:post-response et reste actif dans les deux cas.
  const brut = String(lire("mode_brut", "oui")).toLowerCase() === "oui";
  const verifier = brut
    ? function () {}
    : function (nom, fonction) { return test(nom, fonction); };

  const corps = res.getBody() || {};

  verifier("HTTP 2xx", function () {
    expect(res.getStatus()).to.be.within(200, 299);
  });

  verifier("success = true", function () {
    expect(corps.success, JSON.stringify(corps)).to.equal(true);
  });
}

docs {
  Utilise type_decaissement posé par la requête KYC. Pour forcer un routage sans repasser par le KYC, poser type_decaissement à B2C ou B2B dans l'environnement. En-tête x-operator-key obligatoire.
}
