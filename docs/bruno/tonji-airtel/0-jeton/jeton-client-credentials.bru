meta {
  name: Jeton — client_credentials
  type: http
  seq: 1
}

post {
  url: {{airtel_base_url}}/oauth_token_v2
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "grant_type": "client_credentials",
    "client_id": "{{airtel_client_id}}",
    "client_secret": "{{airtel_client_secret}}"
  }
}

script:post-response {
  // Lecture d'une valeur : variable d'exécution, sinon environnement, sinon défaut.
  // Bruno garde les `vars` de collection en lecture seule, d'où ce passage par les
  // variables d'exécution pour tout ce qui change pendant un run.
  const lire = (cle, defaut) => {
    const execution = bru.getVar(cle);
    if (execution !== undefined && execution !== null && execution !== "") return execution;
    const env = bru.getEnvVar(cle);
    if (env !== undefined && env !== null && env !== "") return env;
    return defaut;
  };

  const corps = res.getBody() || {};

  if (corps.access_token) {
    bru.setVar("airtel_token", corps.access_token);
    // 160 s : l'API expire à 170 s, la marge couvre le temps de transit.
    bru.setVar("airtel_token_expire_ms", String(Date.now() + 160000));
    console.log("[airtel] jeton obtenu, valable 160 s");
  }
}

tests {
  // Lecture d'une valeur : variable d'exécution, sinon environnement, sinon défaut.
  // Bruno garde les `vars` de collection en lecture seule, d'où ce passage par les
  // variables d'exécution pour tout ce qui change pendant un run.
  const lire = (cle, defaut) => {
    const execution = bru.getVar(cle);
    if (execution !== undefined && execution !== null && execution !== "") return execution;
    const env = bru.getEnvVar(cle);
    if (env !== undefined && env !== null && env !== "") return env;
    return defaut;
  };

  // Mode brut (défaut) : la réponse passe telle quelle, aucune vérification n'est
  // jouée. Mettre mode_brut = non pour les rallumer. L'enchaînement des variables,
  // lui, se fait dans script:post-response et reste actif dans les deux cas.
  const brut = String(lire("mode_brut", "oui")).toLowerCase() === "oui";
  const verifier = brut
    ? function () {}
    : function (nom, fonction) { return test(nom, fonction); };

  verifier("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  verifier("un access_token est retourné", function () {
    expect(res.getBody().access_token).to.be.a("string").and.not.empty;
  });

  // L'API annonce 170 s. Si elle change, le cache de 160 s du backend devient
  // faux — ce test le fera remarquer.
  if ((res.getBody() || {}).expires_in !== undefined) {
    verifier("expiration annoncée >= 170 s (cache backend : 160 s)", function () {
      expect(Number(res.getBody().expires_in)).to.be.at.least(170);
    });
  }
}

docs {
  La collection le joue toute seule avant chaque requête. Celle-ci existe pour lire la réponse telle quelle : durée de validité, message d'erreur d'identifiants.
}
